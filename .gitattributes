# Auto-detect text files and normalise line endings to LF in the repo
* text=auto eol=lf

# Windows-specific files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# C# / .NET source
*.cs   text eol=lf
*.csx  text eol=lf
*.vb   text eol=lf

# Project / solution files
*.csproj  text eol=lf
*.vbproj  text eol=lf
*.props   text eol=lf
*.targets text eol=lf

# Visual Studio rewrites solution files as CRLF whenever it opens them, so
# forcing LF here leaves them permanently dirty in git status. Match the tool.
*.sln     text eol=crlf
*.slnx    text eol=crlf

# Config / data
*.json  text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.md    text eol=lf

# Binary files — never mangle these
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.dll  binary
*.exe  binary
*.pdb  binary
