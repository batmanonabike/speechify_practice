<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Speechify.Billing.Tests</RootNamespace>
    <!--
      Theory data deliberately contains nulls (null promo codes, null customer ids)
      and lives in untyped object[] rows, so CS8625 fires on every one of them.
      Silenced here so that a real warning stands out during the exercise.
    -->
    <NoWarn>$(NoWarn);CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Speechify.Billing.Abstractions\Speechify.Billing.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Speechify.Billing.Legacy\Speechify.Billing.Legacy.csproj" />
    <ProjectReference Include="..\..\src\Speechify.Billing\Speechify.Billing.csproj" />
  </ItemGroup>

</Project>
